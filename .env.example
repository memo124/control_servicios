# Database
DATABASE_URL="postgresql://postgres:postgreSQL@192.168.11.132:5432/control_servicios_db?schema=public"

# JWT
JWT_SECRET="change-me-in-production-use-strong-secret"
JWT_EXPIRES_IN="8h"

# Resend
RESEND_API_KEY="re_xxxxxxxx"
MAIL_FROM_ADDRESS="notificaciones@tudominio.com"

# Redis (BullMQ)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379

# Rate limiting (Throttler)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=5

# App
APP_VERSION="1.1.0"
PORT=3000
FRONTEND_URL="http://localhost:5173"
