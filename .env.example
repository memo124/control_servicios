# Database
DATABASE_URL="postgresql://postgres:postgreSQL@192.168.11.132:5432/control_servicios_db?schema=public"

# JWT
JWT_SECRET="change-me-in-production-use-strong-secret"
JWT_EXPIRES_IN="8h"

# Correo — elige proveedor: resend (default) | smtp
MAIL_PROVIDER="resend"
MAIL_FROM_ADDRESS="Notificaciones <notificaciones@tudominio.com>"

# Resend — https://resend.com/api-keys
# Con onboarding@resend.dev SOLO llega al email de tu cuenta Resend (no a clientes).
RESEND_API_KEY="re_xxxxxxxx"
# MAIL_FROM_ADDRESS="Control Servicios <onboarding@resend.dev>"

# SMTP (Gmail, etc.) — envía a cualquier cliente sin dominio en Resend
# MAIL_PROVIDER="smtp"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="tu@gmail.com"
# SMTP_PASS="contraseña-de-aplicacion-16-caracteres"
# MAIL_FROM_ADDRESS="Control Servicios <tu@gmail.com>"

# Redis (BullMQ)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379

# Telegram (2FA, alertas dueño, grupo de equipo)
TELEGRAM_BOT_TOKEN="xxxx:yyyy"
# Chat ID del grupo (negativo). Obténlo con @getidsbot o @RawDataBot dentro del grupo.
TELEGRAM_GROUP_CHAT_ID="-100xxxxxxxxxx"

# Rate limiting (Throttler)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=5

# Datos de pago (variables en plantilla AVISO_PAGO_SUSCRIPCION)
PAYMENT_BANK_NAME="Banco Industrial"
PAYMENT_BANK_ACCOUNT="1234567890"
PAYMENT_ACCOUNT_HOLDER="Tu nombre o razón social"
PAYMENT_PROOF_EMAIL="pagos@tudominio.com"
PAYMENT_PROOF_PHONE="+502 0000-0000"

# App
APP_VERSION="1.5.5"
PORT=3000
# URL pública del frontend (QR login desde el teléfono: usa IP LAN, no localhost)
# FRONTEND_URL="http://192.168.1.10:5173"
FRONTEND_URL="http://localhost:5173"
